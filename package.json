{
  "name": "moke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace @moke/client -- --host 127.0.0.1",
    "dev:server": "tsx apps/server/server.ts",
    "build:server": "node scripts/build-server-bundle.mjs",
    "test:server": "tsx --test apps/server/**/*.test.ts packages/**/*.test.ts apps/client/src/**/*.test.ts",
    "package:desktop": "node scripts/package-desktop.mjs",
    "desktop": "npm run desktop --workspace @moke/client",
    "build": "npm run build --workspace @moke/client"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
